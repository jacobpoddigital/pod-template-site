# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# lighthouse-ci reports (perf budget — docs/performance.md)
/.lighthouseci/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# agent telemetry — local JSONL sink (workflow/15); bulk-imported to the hub in Phase 3
.claude/audit/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local screenshot/scratch captures (CPT proof, ad-hoc)
.screenshots/
