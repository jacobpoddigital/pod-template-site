# Copy to .env.local for local dev. Every required env var is documented here (workflow/01).

# WPGraphQL endpoint — the SOLE content layer (ADR 0013). No REST.
# UNSET (or CMS_MODE=mock) is valid for dev: the dev mock renders blocks against
# the committed src/lib/cms/schema.graphql with no WordPress (lib/cms/mock/).
WPGRAPHQL_URL=http://localhost:{{WP_PORT}}/graphql

# Force the dev mock even when WPGRAPHQL_URL is set (handy for offline iteration).
# Leave blank in production. Values: "mock" | "" (unset).
CMS_MODE=

# WordPress base URL (without path) — used for direct WP admin links + GraphiQL.
WP_BASE_URL=http://localhost:{{WP_PORT}}

# WP application password (generate via WP-CLI — see CLAUDE.md §Gotchas, NOT wp-admin UI).
# docker compose run --rm -T --entrypoint bash cli -c \
#   "wp --allow-root --path=/var/www/html user application-password create admin claude-desktop --porcelain"
WP_APP_USER=admin
WP_APP_PASSWORD=

# Canonical FRONTEND origin — used for metadata/canonical/OG URLs (never the WP origin).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hub URL for dev port registration heartbeat (omit for local-only dev without Hub).
NEXT_PUBLIC_HUB_URL=

# Shared secret for the WP → /api/revalidate webhook (any long random string).
REVALIDATE_SECRET=

# Edit mode login (production only — floating 🔒 button).
EMBED_ADMIN_PASSWORD=
